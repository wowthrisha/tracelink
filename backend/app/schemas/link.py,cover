> import uuid
> from datetime import datetime
> from typing import Optional, List
> from pydantic import BaseModel
  
  
> class LinkCreateRequest(BaseModel):
>     document_id: uuid.UUID
>     label: Optional[str] = None
>     password: Optional[str] = None
