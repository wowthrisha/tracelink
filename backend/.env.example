# ─── DATABASE ──────────────────────────────────────────────────────────────────
# Runtime URL — used by the app and by migrations when running inside Railway.
DATABASE_URL=postgresql+asyncpg://securedoc:password@localhost:5432/securedoc
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# Railway public proxy URL — used by Alembic when running migrations from your
# local Mac (or any machine outside Railway's private network).
# Find it in: Railway dashboard → your Postgres service → Connect → Public URL
# Leave empty if running Docker locally (DATABASE_URL already points to localhost).
DATABASE_PUBLIC_URL=

# Optional hard override for migrations — beats DATABASE_PUBLIC_URL and DATABASE_URL.
# Use only when you need to target a specific DB (e.g. staging vs. production).
# MIGRATION_DATABASE_URL=

# Storage (Cloudflare R2 — also works with AWS S3)
STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key
STORAGE_BUCKET_NAME=securedoc-docs
STORAGE_PUBLIC_BASE_URL=https://your-r2-domain.com  # only for public assets

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# JWT (internal share-link tokens)
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_LINK_EXPIRE_HOURS=24

# Supabase (user authentication — copy from Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# App
APP_ENV=development

# ─── PUBLIC URL ────────────────────────────────────────────────────────────────
# Controls the base URL in every generated share link: {APP_PUBLIC_BASE_URL}/v/{token}
# This is the SINGLE source of truth for all generated share links.
#
# ── Development (local only) ──
#   APP_PUBLIC_BASE_URL=http://localhost:8000
#
# ── Quick Tunnel (temporary public URL, no DNS needed) ──
#   Run: ./start.sh quicktunnel
#   → APP_PUBLIC_BASE_URL is auto-updated to https://<random>.trycloudflare.com
#   NOTE: URL changes on every restart — existing links break. Use for demos only.
#
# ── Production (stable custom domain — RECOMMENDED) ──
#   Set APP_ENV=production and use your real domain:
#   APP_PUBLIC_BASE_URL=https://secure.yourdomain.com
#   ALLOWED_ORIGINS=https://secure.yourdomain.com
#   FRONTEND_BASE_URL=https://secure.yourdomain.com
#   APP_ENV=production
#
APP_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# ─── CLOUDFLARE TUNNEL (optional — named tunnel only) ─────────────────────────
# For quick tunnel: no token needed — just run ./start.sh quicktunnel
# For named tunnel with custom domain: obtain token from Cloudflare Zero Trust → Networks → Tunnels
#   then run: ./start.sh tunnel
CLOUDFLARE_TUNNEL_TOKEN=

MAX_UPLOAD_MB=100
MAX_PAGES_PER_DOC=500
WATERMARK_OPACITY=0.22
PAGE_TILE_DPI=150
PAGE_FORMAT=WEBP
PAGE_TILE_QUALITY=85

# ─── SECURITY ──────────────────────────────────────────────────────────────────
# Salt for IP address hashing. Set to a long random secret — never commit the
# real value. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=change_me_to_a_long_random_secret_in_production

# PDF rasterizer timeout in seconds (default 300). Prevents PDF-bomb DoS.
RASTERIZER_TIMEOUT_SEC=300

# ─── BILLING (Stripe — optional) ───────────────────────────────────────────────
# Leave empty to disable billing (app works fully without it).
# Use Stripe test keys for development: https://dashboard.stripe.com/test/apikeys
#
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
FREE_PLAN_DOC_LIMIT=10

# ─── DEMO / LOCAL STORAGE (development only) ──────────────────────────────────
# Set USE_DEMO_STORAGE=1 to skip Supabase and store files on local disk at
# /tmp/securedoc_storage/. APP_ENV must also be "development".
# Used by: ./start.sh backend  (run_demo.py sets this automatically)
# NOT for Docker: the full Docker stack uses real storage via STORAGE_* vars above.
#USE_DEMO_STORAGE=1
